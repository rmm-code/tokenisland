<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Click-to-jump drives Terminal and iTerm2 through AppleScript. Under the
       hardened runtime (required for notarization) Apple Events are blocked
       without this, so jumping would fail on every distributed build. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
